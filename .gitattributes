# Auto detect text files and perform LF normalization on checkout
* text=auto

# Explicitly declare text files
*.py text eol=lf
*.csv text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.tex text eol=lf

# Binary files
*.parquet binary
*.npz binary
*.pt binary
*.png binary
*.pdf binary
